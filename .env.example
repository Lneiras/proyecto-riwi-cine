DB_CONTAINER_NAME=riwi-cine-db
POSTGRES_USER=nodejs
POSTGRES_PASSWORD=contrasena
POSTGRES_DB=postgres
POSTGRES_PORT=5432

APP_CONTAINER_NAME=riwi-cine-backend
APP_PORT=3000

DB_CPU_LIMIT = 2
DB_MEM_LIMIT = 512MB

APP_CPU_LIMIT = 2
APP_MEM_LIMIT = 512MB

NODE_ENV = development

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200,https://midominio.com,https://www.midominio.com

# JWT
# IMPORTANTE: usa un secreto fuerte y único por ambiente (NUNCA el de dev en producción)
JWT_SECRET=dev-secret-riwi-cine-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# pgAdmin (solo desarrollo)
PGADMIN_CONTAINER_NAME=riwi-cine-pgadmin
PGADMIN_DEFAULT_EMAIL=admin@riwicine.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
PGADMIN_CPU_LIMIT=0.5
PGADMIN_MEM_LIMIT=256MB
