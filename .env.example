DB_CONTAINER_NAME=riwi-cine-db
POSTGRES_USER=nodejs
POSTGRES_PASSWORD=contrasena
POSTGRES_DB=postgres
POSTGRES_PORT=5432

APP_CONTAINER_NAME=riwi-cine-backend
APP_PORT=3000

DB_CPU_LIMIT = 2
DB_MEM_LIMIT = 512MB

APP_CPU_LIMIT = 2
APP_MEM_LIMIT = 512MB

NODE_ENV = development

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200,https://midominio.com,https://www.midominio.com

# JWT
# IMPORTANTE: usa un secreto fuerte y único por ambiente (NUNCA el de dev en producción)
JWT_SECRET=dev-secret-riwi-cine-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# pgAdmin (solo desarrollo)
PGADMIN_CONTAINER_NAME=riwi-cine-pgadmin
PGADMIN_DEFAULT_EMAIL=admin@riwicine.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
PGADMIN_CPU_LIMIT=0.5
PGADMIN_MEM_LIMIT=256MB

# HU-006 - Registro, CAPTCHA y activación de cuenta
# En desarrollo se puede omitir Turnstile con CAPTCHA_BYPASS=false.
# En producción CAPTCHA_BYPASS no tiene efecto y TURNSTILE_SECRET_KEY es obligatorio.
CAPTCHA_BYPASS=true
TURNSTILE_SECRET_KEY=0x4AAAAAAEVnSUPFjjtKsLG4orWfdyKXFdw
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# URL pública del backend usada para construir el enlace de activación.
APP_PUBLIC_URL=http://localhost:3000

# Correo de activación. "console" solo imprime el enlace en desarrollo.
# En producción se utiliza Resend mediante fetch y RESEND_API_KEY es obligatorio.
EMAIL_DELIVERY_MODE=console
RESEND_API_KEY=
EMAIL_FROM=no-reply@multicine.com

# Redis 
REDIS_CONTAINER_NAME=riwi-cine-redis 
REDIS_URL=redis://localhost:6379 
REDIS_PORT=6379 
# Bloqueo temporal de asientos # 600 segundos = 10 minutos 
SEAT_LOCK_TTL_SECONDS=600 
# Fallback de expiración cada 30 segundos 
SEAT_LOCK_SWEEP_MS=30000 
# Máximo de asientos que puede bloquear un usuario 
MAX_SEATS_PER_LOCK=6 
# Servidor realtime 
SOCKET_PORT=3001

PREFERENTIAL_SEAT_POLICY=allow



CART_TTL_SECONDS=600

# IVA general configurable
CART_TAX_PERCENT=19